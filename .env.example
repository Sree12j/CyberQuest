# Copy this file to .env and replace the sample secret with your own value.
# The .env file is ignored by Git and must never be committed.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional: add origins when DEBUG is False or when testing with a custom domain.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------------------
# Database configuration
# ---------------------------------------------------------------------------
# Leave every database variable below commented out to use the local SQLite
# fallback. No PostgreSQL server is required in that mode.

# Option A (recommended locally): individual PostgreSQL variables.
# POSTGRES_DB=cyberquest
# POSTGRES_USER=cyberquest
# POSTGRES_PASSWORD=replace-with-your-postgres-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Option B: a single database URL. If set, this takes priority over Option A.
# URL-encode special characters in the password.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
